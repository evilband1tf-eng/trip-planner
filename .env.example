# 服务端接口地址（默认 /api，配合 vite 代理或同域部署）
# 前端部署到 GitHub Pages、接口部署在别处时，填完整地址，例如：
# VITE_API_BASE=https://trip-planner-api.onrender.com/api
VITE_API_BASE=/api

# 数据存储模式：留空自动探测（有后端用后端，纯静态托管自动降级到浏览器本地存储）
# local  = 强制使用浏览器 localStorage
# remote = 强制使用服务端接口
VITE_DATA_MODE=

# 服务端端口（仅后端使用；Render 等平台会自动注入）
PORT=8787
